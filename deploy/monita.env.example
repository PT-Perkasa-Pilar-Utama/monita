# /etc/monita/monita.env, mode 0600, owner monita. See docs/technical-specs/11-environment-configuration.md
MONITA_ENV=prod
# Only the reverse proxy may reach this port: MONITA_TRUST_PROXY trusts X-Forwarded-For.
MONITA_BIND=127.0.0.1:7466
MONITA_BASE_URL=https://monita.company.co.id
MONITA_DB_PATH=/var/lib/monita/monita.db
MONITA_BACKUP_DIR=/var/backups/monita
MONITA_BACKUP_KEEP=7
MONITA_SMTP_URL=smtps://user:password@smtp.company.co.id:465
# Quote a value with spaces or < >: systemd and the README's shell bootstrap both read this file.
MONITA_MAIL_FROM="Monita <monita@company.co.id>"
MONITA_PING_URL=
MONITA_TRUST_PROXY=true
MONITA_DIGEST_UTC_HOUR=1
MONITA_LOG=info
MONITA_LOG_FORMAT=json
